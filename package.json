{
    "name": "fan-control-app",
    "version": "1.0.0",
    "description": "An application to control fans under heaters",
    "main": "src/index.ts",
    "type": "module",
    "scripts": {
        "start": "bun run src/index.ts",
        "dev": "bun --watch run src/index.ts",
        "build": "bun build src/index.ts --outdir dist",
        "test": "bun test",
        "generate": "drizzle-kit generate:pg",
        "migrate": "bun run src/db/migrate.ts"
    },
    "keywords": [
        "fan-control",
        "iot",
        "heater"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "dotenv": "^16.3.1",
        "drizzle-orm": "^0.29.1",
        "hono": "^3.11.10",
        "pino": "^8.16.2",
        "pino-pretty": "^10.2.3",
        "postgres": "^3.4.5",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/bun": "^1.2.5",
        "@types/node": "^20.10.4",
        "bun-types": "latest",
        "drizzle-kit": "^0.30.5",
        "typescript": "^5.3.3"
    }
}